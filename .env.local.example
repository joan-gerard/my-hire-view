# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (CV PDFs) — https://developers.cloudflare.com/r2/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL for the bucket (custom domain or R2.dev), no trailing slash
R2_PUBLIC_BASE_URL=

# Canonical site URL for share links — required in production on the server (set to your public URL)
NEXT_PUBLIC_SITE_URL=

# Upstash Redis — durable rate limiting across serverless instances (D3-001)
# https://console.upstash.com/ → Redis → REST API
# Required in production; without these, limits fall back to in-memory (per instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
